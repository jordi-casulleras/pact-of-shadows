{
  "name": "pact-of-shadows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "SIM_GAMES=200 vitest run sim-report --disable-console-intercept",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "e2e": "node e2e/play.mjs desktop && node e2e/play.mjs mobile 5 master 11 && node e2e/checks.mjs && node e2e/online.mjs",
    "build:fn": "rolldown src/net/edge.ts --file supabase/functions/room/index.ts --format esm",
    "deploy:fn": "npm run build:fn && npx supabase functions deploy room",
    "art": "scripts/art.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
